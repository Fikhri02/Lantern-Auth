      },
      {
        "name": "hq-staff",
        "description": "Base HQ role: dashboard and read-only reports"
      },
      {
        "name": "marketing",
        "description": "Creates and schedules promotions"
      },
      {
        "name": "procurement",
        "description": "Raises purchase orders, reads stock and suppliers"
      },
      {
        "name": "finance",
        "description": "Reads sales reports, approves purchase orders"
      },
      {
        "name": "outlet-manager",
        "description": "Manages one outlet in Outlet Admin"
      },
      {
        "name": "outlet-device",
